{
  "profile": {
    "name": "low-memory",
    "target_gpu_memory_gb": 6,
    "target_system_memory_gb": 16
  },
  "policy_model": "HuggingFaceTB/SmolLM2-135M-Instruct",
  "reward_model": "OpenAssistant/reward-model-deberta-v3-base",
  "data": {
    "sft_dataset": "HuggingFaceH4/ultrachat_200k",
    "sft_split": "train_sft",
    "sft_examples": 2000,
    "preference_dataset": "HuggingFaceH4/ultrafeedback_binarized",
    "preference_split": "train_prefs",
    "preference_examples": 4000,
    "prompt_examples": 500,
    "eval_source_examples": 4000,
    "eval_prompt_examples": 200,
    "train_ratio": 0.8,
    "validation_ratio": 0.1,
    "test_ratio": 0.1
  },
  "lora": {
    "rank": 8,
    "alpha": 16,
    "dropout": 0.05
  },
  "training": {
    "max_length": 384,
    "max_prompt_length": 160,
    "max_completion_length": 224,
    "batch_size": 1,
    "gradient_accumulation_steps": 8,
    "max_steps": {
      "sft": 200,
      "dpo": 200,
      "grpo": 80
    },
    "sft_learning_rate": 0.0001,
    "dpo_learning_rate": 0.00005,
    "grpo_learning_rate": 0.00001,
    "dpo_beta": 0.1,
    "grpo_beta": 0.02,
    "grpo_generations": 4,
    "estimated_gpu_hours": {
      "sft": "0.5-2",
      "dpo": "1-3",
      "grpo": "3-8"
    }
  }
}
